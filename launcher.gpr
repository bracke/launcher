with "config/launcher_config.gpr";
with "../messages/messages.gpr";
project Launcher is

   case Launcher_Config.Alire_Host_OS is
      when "windows" =>
         for Source_Dirs use ("src/", "config/", "src/platform/windows");
      when "macos" =>
         for Source_Dirs use ("src/", "config/", "src/platform/macos");
      when "linux" =>
         for Source_Dirs use ("src/", "config/", "src/platform/linux");
      when others =>
         for Source_Dirs use ("src/", "config/", "src/platform/unsupported");
   end case;
   for Object_Dir use "obj/" & Launcher_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("launcher-main.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Launcher_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnatwU");
   end Compiler;


   --  Bytes out as bytes in. Alire's generated switches carry -gnatW8 and the
   --  binder takes its run-time encoding from the same place, which makes
   --  Ada.Text_IO encode every byte above 127 a second time on the way out:
   --  text that was already UTF-8 -- an accented path, an internationalized
   --  domain name, a translated message -- came out doubled. -Wb is the
   --  compiler default and leaves the bytes alone.
   package Binder is
      for Switches ("Ada") use ("-Es", "-Wb"); --  Symbolic traceback
   end Binder;

   package Linker is
      case Launcher_Config.Alire_Host_OS is
         when "windows" =>
            --  The Vulkan loader is vulkan-1.dll on Windows, so the library is
            --  vulkan-1, not vulkan. Asking for -lvulkan there does not link at all.
            for Default_Switches ("Ada") use
              ("-lvulkan-1", "-lgdk_pixbuf-2.0", "-lgobject-2.0", "-lglib-2.0",
               --  ShellExecuteW, which starts a Start Menu shortcut.
               "-lshell32");
         when others =>
            for Default_Switches ("Ada") use
              ("-lvulkan", "-lgdk_pixbuf-2.0", "-lgobject-2.0", "-lglib-2.0");
      end case;
   end Linker;

   package Builder is
      for Executable ("launcher-main.adb") use "launcher";
   end Builder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Launcher;
